<UserControl x:Class="TypeCatalogMVP.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220">
  <DockPanel Margin="6">

    <!-- Search + refresh -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" Padding="4,2" VerticalContentAlignment="Center"
               Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Grid.Column="1" Content="Refresh" Margin="6,0,0,0" Padding="8,2"
              Command="{Binding RefreshCommand}"/>
    </Grid>

    <!-- Catalog list, grouped by category -->
    <ListBox ItemsSource="{Binding ItemsView}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,8,2,2"/>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>

      <ListBox.ItemTemplate>
        <DataTemplate>
          <!-- Click anywhere on the card to enter placement -->
          <Button HorizontalContentAlignment="Left" Margin="0,2" Padding="4"
                  Command="{Binding DataContext.PlaceCommand,
                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
              <Border Width="48" Height="48" Margin="0,0,8,0" Background="#22000000">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FamilyName}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>
